# Drop-in dev config for local hacking without MySQL.
# Use this file when you'd rather not run a MySQL server: copy it to .env
# (or point uvicorn at it explicitly) and you get a self-contained SQLite DB.
#
#   cp backend/.env.dev backend/.env
#   ./scripts/migrate.sh
#   ./scripts/dev_backend.sh

ENVIRONMENT=development

DATABASE_URL=sqlite:///./nvr.db

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

FFMPEG_PATH=ffmpeg
HLS_SEGMENT_SECONDS=2
HLS_LIST_SIZE=5
MAX_CONCURRENT_STREAMS=4

RECORDING_SEGMENT_MINUTES=10
RETENTION_DAYS=7

SECRET_KEY=dev-only-not-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
