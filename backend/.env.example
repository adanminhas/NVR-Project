# Copy this file to backend/.env and fill in real values.
# Never commit the actual .env file.

# Environment mode: development | production
ENVIRONMENT=development

# SQLAlchemy database URL.
# MySQL example:
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost/nvr
# SQLite for local dev (no server needed):
# DATABASE_URL=sqlite:///./nvr.db

# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# FFmpeg
FFMPEG_PATH=ffmpeg
HLS_SEGMENT_SECONDS=2
HLS_LIST_SIZE=5
MAX_CONCURRENT_STREAMS=4

# Recording
RECORDING_SEGMENT_MINUTES=10
RETENTION_DAYS=7

# Auth — change SECRET_KEY to a long random string in production.
# `openssl rand -hex 32` produces a good one.
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Bootstrap admin — created on first startup if no users exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
