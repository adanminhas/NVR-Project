# Copy this file to backend/.env and fill in real values.
# Never commit the actual .env file.

# Environment mode: development | production
ENVIRONMENT=development

# SQLAlchemy database URL.
# MySQL example:
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost/nvr
# SQLite for local dev (no server needed):
# DATABASE_URL=sqlite:///./nvr.db

# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex; if set, any origin matching it is also allowed.
# This default permits LAN IPs (RFC1918) on any port — useful for mobile testing.
CORS_ORIGIN_REGEX=^http://(192\.168\.\d+\.\d+|10\.\d+\.\d+\.\d+|172\.(1[6-9]|2[0-9]|3[01])\.\d+\.\d+)(:\d+)?$

# FFmpeg
FFMPEG_PATH=ffmpeg
HLS_SEGMENT_SECONDS=2
HLS_LIST_SIZE=5
MAX_CONCURRENT_STREAMS=4

# Recording
RECORDING_SEGMENT_MINUTES=10
RETENTION_DAYS=7

# Auth — change SECRET_KEY to a long random string in production.
# `openssl rand -hex 32` produces a good one.
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Bootstrap admin — created on first startup if no users exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
